# ---------------------------------------------------------------
# DarkPose environment configuration
# Copy this file to .env and adjust the values for your setup.
# ---------------------------------------------------------------

# --- PyTorch / CUDA ---
TORCH_VER=1.0.1
TORCHVISION_VER=0.3.0

# --- Dataset paths ---
DATASET_ROOT=${HOME}/datasets
COCO_ROOT=${DATASET_ROOT}/MSCOCO
MPII_ROOT=${DATASET_ROOT}/MPII
MODELS_ROOT=${DATASET_ROOT}/models

# --- Training ---
GPUS=(0,1,2,3)
WORKERS=24
BATCH_SIZE_PER_GPU=32

# --- Output ---
OUTPUT_DIR=output
LOG_DIR=log
